# Conflict check for @@NAME@@ (@@RES@@) - run in your server's resources folder, before or after installing the map
# (this map's own folders are skipped). The file list below is written by the build from the files this map ships.
# Lists every resource you already have that replaces the same Rockstar map files (they would fight with this map),
# plus any script that loads the Rockstar interiors / IPLs this map removes or sits on. Read-only: it changes nothing.
# Usage (PowerShell), from your server resources folder:  powershell -ExecutionPolicy Bypass -File .\@@RES@@\tools\check_conflicts.ps1
$names = @'
@@FILES@@
'@ -split "`r?`n" | Where-Object { $_ }
$set = @{}; foreach ($n in $names) { $set[$n.ToLower()] = 1 }
$family = '@@FAMILY@@'
function Get-Res($path) { $d = Split-Path $path; while ($d -and -not (Test-Path -LiteralPath (Join-Path $d 'fxmanifest.lua')) -and -not (Test-Path -LiteralPath (Join-Path $d '__resource.lua'))) { $d = Split-Path $d }; if ($d) { Split-Path $d -Leaf } else { '(no manifest)' } }
$files = Get-ChildItem -Recurse -File -ErrorAction SilentlyContinue | Where-Object { $_.FullName -notmatch '@@SKIP@@' }
$hits = foreach ($f in $files) {
  $n = $f.Name.ToLower()
  if ($set.ContainsKey($n)) { [pscustomobject]@{ Resource = Get-Res $f.FullName; File = $f.Name; Match = 'SAME FILE'; Path = $f.FullName } }
  elseif ($family -and $n -match $family -and $n -match '\.(ydr|ydd|yft|ytd|ybn|ymap|ytyp)$') { [pscustomobject]@{ Resource = Get-Res $f.FullName; File = $f.Name; Match = 'same area (map file family)'; Path = $f.FullName } }
}
$refs = @(@@REFS@@)
$scripts = $files | Where-Object { $_.Extension -in '.lua','.cfg','.json','.js' }
$refHits = foreach ($s in $scripts) { foreach ($r in $refs) { if (Select-String -Path $s.FullName -SimpleMatch $r -Quiet -ErrorAction SilentlyContinue) { [pscustomobject]@{ Resource = Get-Res $s.FullName; Mentions = $r; Path = $s.FullName } } } }
"`n=== @@NAME@@ (@@RES@@) : file conflicts ==="
if ($hits) { $hits | Sort-Object Resource, File | Format-Table Resource, File, Match, Path -AutoSize -Wrap; "{0} conflicting file(s) in: {1}" -f @($hits).Count, ((@($hits.Resource) | Sort-Object -Unique) -join ', ') } else { 'No file conflicts found.' }
"`n=== scripts / configs that use the area or its interiors ==="
if ($refHits) { $refHits | Sort-Object Resource | Format-Table -AutoSize -Wrap } else { 'None found.' }
"`nAlso check by hand: any other MLO / map placed at @@AREA@@ (different file names would not show above)."
